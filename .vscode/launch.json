{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Chạy Đồ Án CTRR (run_demo.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_demo.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "🤖 Chạy Mô Phỏng Robot Hút Bụi Thông Minh (run_robot_sim.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_robot_sim.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "🐍 Chạy File Python Đang Mở",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "🧪 Chạy Tất Cả Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s",
                "tests"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
